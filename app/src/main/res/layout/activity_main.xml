<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heading_input"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_hours"
            android:inputType="numberDecimal"
            android:autofillHints="" />

        <EditText
            android:id="@+id/etRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_rate"
            android:inputType="numberDecimal"
            android:autofillHints="" />

        <EditText
            android:id="@+id/etTaxRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tax"
            android:inputType="numberDecimal"
            android:autofillHints="" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_calculate" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/heading_results"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_pay_empty"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvOvertimePay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_overtime_empty"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTotalPay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_total_empty"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_tax_empty"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
